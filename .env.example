# ---------------------------------------------------------------------------
# STARK configuration
# Everything below is OPTIONAL. With no .env at all the app boots and runs the
# full demo using the bundled local memory engine + deterministic synthesis.
# ---------------------------------------------------------------------------

# --- Hindsight -------------------------------------------------------------
# Hindsight Cloud:  https://ui.hindsight.vectorize.io   (promo MEMHACK89)
# Self-hosted:      http://localhost:8888
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=stark-oncall

# --- LLM (Groq is fast + free tier: https://groq.com) ----------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- App -------------------------------------------------------------------
STARK_HOST=127.0.0.1
STARK_PORT=8000
STARK_STATE_DIR=.stark
